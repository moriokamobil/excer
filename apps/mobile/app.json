{
  "expo": {
    "name": "失われた美術館の修復",
    "slug": "lost-museum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1030"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "散らばった名画のピースを集めるため、現在地を使用します（フォアグラウンドのみ）。"
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": ["expo-location", "expo-av"],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
